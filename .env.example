OPENAI_API_KEY=
# Optional: DeepSeek API key (falls back to OPENAI_API_KEY if unset)
DEEPSEEK_API_KEY=
PRDS_LLM_MODEL=gpt-4o-mini
PRDS_LLM_MODEL_ANALYSIS=gpt-4o
# DeepSeek example (do NOT put the DeepSeek key in OPENAI_API_KEY):
# PRDS_LLM_MODEL=deepseek-v4-flash
# PRDS_LLM_MODEL_ANALYSIS=deepseek-v4-flash
# DEEPSEEK_API_KEY=sk-...
# PRDS_LLM_API_BASE=https://api.deepseek.com/v1
# Graphiti entity extraction on DeepSeek (optional; needs Neo4j + embedding below):
# GRAPHITI_LLM_MODEL=deepseek-chat
# Or use OpenAI-compatible proxy:
# PRDS_LLM_PROVIDER=openai
# PRDS_LLM_API_BASE=https://your-proxy.example/v1
PRDS_MAX_CONCURRENT_LLM=20
PRDS_DEFAULT_AGENT_COUNT=50
PRDS_DEFAULT_PERIODS=120
PRDS_DATABASE_URL=sqlite+aiosqlite:///./prds.db
PRDS_CHECKPOINT_INTERVAL=5
PRDS_LOGS_DIR=./data/logs
PRDS_USE_GRAPHRAG=true

# Industry background research (step ②)
# Provider selection: auto|deep_research|grounded|fallback|off
#   auto  -> deep_research if GEMINI_API_KEY set, else fallback (in-house LLM, no web)
PRDS_RESEARCH_ENABLED=true
PRDS_RESEARCH_PROVIDER=auto
GEMINI_API_KEY=
# deep_research is async and can take up to ~20 min per run
PRDS_RESEARCH_MODEL=deep-research-preview-04-2026
PRDS_RESEARCH_GROUNDED_MODEL=gemini-2.5-flash
PRDS_RESEARCH_TIMEOUT_S=1200
PRDS_RESEARCH_POLL_INTERVAL_S=10
# Grow the knowledge graph period-by-period via LLM episode extraction ("hop by hop").
PRDS_DYNAMIC_GRAPH=true

# Neo4j (optional — knowledge graph persistence)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Knowledge-graph backend: auto | graphiti | builtin
# - graphiti: episode-driven GraphRAG on Graphiti + Neo4j (needs the deps in
#   requirements-graphiti.txt, a running Neo4j, and an embeddings endpoint below)
# - builtin: in-house incremental extractor (no extra infra)
# - auto: graphiti when Neo4j + embeddings are configured, else builtin
PRDS_GRAPH_BACKEND=auto
# Embeddings for Graphiti (OpenAI-compatible). Required when using DeepSeek for LLM.
# DashScope example:
GRAPHITI_EMBEDDING_API_KEY=
GRAPHITI_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GRAPHITI_EMBEDDING_MODEL=text-embedding-v4
# OpenAI example:
# GRAPHITI_EMBEDDING_API_BASE=https://api.openai.com/v1
# GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small
# Graphiti entity/edge extraction LLM (often DashScope qwen when simulation LLM is DeepSeek).
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GRAPHITI_LLM_MODEL=qwen-plus
GRAPHITI_ASYNC_TIMEOUT_S=300
