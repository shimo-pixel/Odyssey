OPENAI_API_KEY=
# Optional: DeepSeek API key (falls back to OPENAI_API_KEY if unset)
DEEPSEEK_API_KEY=
PRDS_LLM_MODEL=gpt-4o-mini
PRDS_LLM_MODEL_ANALYSIS=gpt-4o
# DeepSeek example (do NOT put the DeepSeek key in OPENAI_API_KEY):
# PRDS_LLM_MODEL=deepseek-v4-flash
# PRDS_LLM_MODEL_ANALYSIS=deepseek-v4-flash
# DEEPSEEK_API_KEY=sk-...
# PRDS_LLM_API_BASE=https://api.deepseek.com/v1
# Or use an OpenAI-compatible proxy:
# PRDS_LLM_PROVIDER=openai
# PRDS_LLM_API_BASE=https://your-proxy.example/v1
PRDS_MAX_CONCURRENT_LLM=20

# Defaults for the two knobs the user sets per run
# PRDS_DEFAULT_AGENT_COUNT = number of coping strategies explored in parallel
PRDS_DEFAULT_AGENT_COUNT=4
PRDS_DEFAULT_MAX_EVENTS=6

PRDS_DATABASE_URL=sqlite+aiosqlite:///./prds.db
PRDS_LOGS_DIR=./data/logs
PRDS_KB_UPLOAD_DIR=./data/kb
# LightRAG sidecar (knowledge base + graph UI)
PRDS_LIGHTRAG_URL=http://127.0.0.1:9621

# --- Branch simulation (kbsim) ---
# Share of branches that get a rational decision profile; the rest are irrational.
PRDS_KBSIM_RATIONAL_RATIO=0.7
# Black swans only appear once the timeline is at least this long.
PRDS_KBSIM_BLACK_SWAN_MIN_EVENTS=20
PRDS_KBSIM_BLACK_SWAN_RATIO=0.08
PRDS_KBSIM_MAX_BLACK_SWANS=3
# Hard cap on strategies x events; runs above this are rejected with a 422.
PRDS_KBSIM_MAX_STEPS=200
PRDS_KBSIM_MAX_CONCURRENT_BRANCHES=8
# Above this total source-KB size, skip per-branch copies and read the originals.
PRDS_KBSIM_MAX_FORK_BYTES=536870912
# Write the new state back into each branch KB every N events (2 = faster, coarser).
PRDS_KBSIM_REINDEX_EVERY=1
PRDS_KBSIM_INDEX_TIMEOUT_S=300
PRDS_KBSIM_RETRIEVAL_CHARS=6000
# Keep branch workspaces after the run so their graphs stay browsable.
PRDS_KBSIM_KEEP_BRANCHES=true
