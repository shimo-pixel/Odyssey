### DTS LightRAG — Docker Compose runtime template
### Copy to .env before `docker compose -f docker-compose.dts.yml up`
###   cp env.docker-compose.dts.example .env

### Required in .env when running inside Docker (replace LIGHTRAG_RUNTIME_TARGET=host if set)
LIGHTRAG_RUNTIME_TARGET=compose

HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='DTS LightRAG'
WEBUI_DESCRIPTION='DTS customized LightRAG with workspace, sqlite/csv import, federated query'

WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts
TIKTOKEN_CACHE_DIR=/app/data/tiktoken

SUMMARY_LANGUAGE=Chinese
LOG_LEVEL=INFO

###########################################################################
### LLM (cloud API — works from container without extra setup)
###########################################################################
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-v4-flash
MAX_ASYNC_LLM=4
LLM_TIMEOUT=240

###########################################################################
### Embedding (must stay consistent with existing workspace vectors)
###########################################################################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://llm-jzxz89xh9aq94kg0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true
EMBEDDING_BATCH_NUM=10

###########################################################################
### Optional: Ollama on the host (uncomment and comment cloud LLM above)
### Use host.docker.internal — NOT localhost — inside Docker.
###########################################################################
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://host.docker.internal:11434
# LLM_MODEL=qwen3.5:9b
# OLLAMA_LLM_NUM_CTX=32768
# EMBEDDING_BINDING=ollama
# EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
# EMBEDDING_MODEL=qwen3-embedding:4b
# EMBEDDING_DIM=2560
# OLLAMA_EMBEDDING_NUM_CTX=8192

###########################################################################
### SQLite / CSV import (multipart upload)
###########################################################################
# SQLITE_UPLOAD_MAX_BYTES=104857600
# SQLITE_IMPORT_ALLOWED_DIRS=/app/data/rag_storage/sqlite_uploads
### When false, import_sync stores uploaded .db/.csv without LLM/embedding (upload-only)
# LIGHTRAG_LLM_ENABLED=true
# LIGHTRAG_EMBEDDING_ENABLED=true

###########################################################################
### Federated query — JSON list of remote domain LightRAG endpoints
###########################################################################
# FEDERATED_LIGHTRAG_DOMAINS=[{"domain_id":"domain-a","base_url":"http://host.docker.internal:9621","workspace":"dom-xxx","api_key":null}]
