# DTS build Dockerfile — domestic mirrors by default (override via build-arg).
#   docker compose build
#   docker compose build --build-arg PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

ARG DOCKER_MIRROR=docker.m.daocloud.io
ARG GHCR_MIRROR=ghcr.nju.edu.cn
ARG DEBIAN_MIRROR=mirrors.aliyun.com
ARG PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG RUSTUP_DIST_SERVER=https://rsproxy.cn
ARG RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

# Frontend build stage
FROM --platform=$BUILDPLATFORM ${DOCKER_MIRROR}/oven/bun:1 AS frontend-builder

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

WORKDIR /app

COPY lightrag_webui/ ./lightrag_webui/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd lightrag_webui \
    && bun install --frozen-lockfile \
    && bun run build

# Python build stage
FROM ${GHCR_MIRROR}/astral-sh/uv:python3.12-bookworm-slim AS builder

ARG DEBIAN_MIRROR
ARG PYPI_INDEX
ARG RUSTUP_DIST_SERVER
ARG RUSTUP_UPDATE_ROOT

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_INDEX_URL=${PYPI_INDEX}
ENV PIP_INDEX_URL=${PYPI_INDEX}
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV RUSTUP_DIST_SERVER=${RUSTUP_DIST_SERVER}
ENV RUSTUP_UPDATE_ROOT=${RUSTUP_UPDATE_ROOT}

WORKDIR /app

RUN sed -i "s|deb.debian.org/debian-security|${DEBIAN_MIRROR}/debian-security|g; \
            s|deb.debian.org|${DEBIAN_MIRROR}|g; \
            s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /root/.cargo \
    && printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "rsproxy-sparse"' \
        '' \
        '[source.rsproxy-sparse]' \
        'registry = "sparse+https://rsproxy.cn/index/"' \
        > /root/.cargo/config.toml \
    && curl --proto '=https' --tlsv1.2 -sSf https://rsproxy.cn/rustup-init.sh | sh -s -- -y

ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

RUN mkdir -p /root/.local/share/uv

COPY pyproject.toml .
COPY setup.py .
COPY uv.lock .

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-install-project --no-editable

COPY lightrag/ ./lightrag/
COPY --from=frontend-builder /app/lightrag/api/webui ./lightrag/api/webui

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-editable

RUN mkdir -p /app/data/tiktoken \
    && uv run lightrag-download-cache --cache-dir /app/data/tiktoken || status=$?; \
    if [ -n "${status:-}" ] && [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then exit "$status"; fi

# uv CLI binary (separate stage for COPY)
FROM ${GHCR_MIRROR}/astral-sh/uv:latest AS uv-bin

# Final stage
FROM ${DOCKER_MIRROR}/library/python:3.12-slim

ARG PYPI_INDEX

ENV UV_SYSTEM_PYTHON=1
ENV UV_INDEX_URL=${PYPI_INDEX}
ENV PIP_INDEX_URL=${PYPI_INDEX}
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

WORKDIR /app

COPY --from=uv-bin /uv /usr/local/bin/uv

COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/lightrag ./lightrag
COPY pyproject.toml .
COPY setup.py .
COPY uv.lock .

ENV PATH=/app/.venv/bin:/root/.local/bin:$PATH

RUN --mount=type=cache,target=/root/.local/share/uv \
    uv sync --frozen --no-dev --extra api --extra offline --no-editable \
    && /app/.venv/bin/python -m ensurepip --upgrade

RUN mkdir -p /app/data/rag_storage /app/data/inputs /app/data/prompts /app/data/tiktoken

COPY --from=builder /app/data/tiktoken /app/data/tiktoken

ENV TIKTOKEN_CACHE_DIR=/app/data/tiktoken
ENV WORKING_DIR=/app/data/rag_storage
ENV INPUT_DIR=/app/data/inputs
ENV PROMPT_DIR=/app/data/prompts

EXPOSE 9621

ENTRYPOINT ["python", "-m", "lightrag.api.lightrag_server"]
